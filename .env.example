# Copy to .env and fill in. .env is git-ignored.

# Claude API (default)
ANTHROPIC_API_KEY=

# Or Amazon Bedrock: set MODEL_PROVIDER=bedrock, a region, and a Bedrock API key
# (without the key, the normal AWS credential chain is used).
# MODEL_PROVIDER=bedrock
# AWS_REGION=eu-central-1
# AWS_BEARER_TOKEN_BEDROCK=

# ANTHROPIC_MODEL=claude-opus-5-5   # default; on Bedrock the region's profile, e.g. eu.anthropic.claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# PORT=3000
